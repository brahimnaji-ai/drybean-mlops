# Runtime environment: local, ci, or prod.
DRYBEAN_ENV=local
# Application log level: DEBUG, INFO, WARNING, or ERROR.
DRYBEAN_LOG_LEVEL=INFO
# Path to the champion model file.
DRYBEAN_MODEL_PATH=models/champion.pkl
# Path to the pipeline parameters YAML file.
DRYBEAN_PARAMS_PATH=configs/params.yaml
# MLflow tracking server URI.
DRYBEAN_MLFLOW_TRACKING_URI=http://localhost:5000
# Optional S3-compatible object store endpoint.
DRYBEAN_S3_ENDPOINT_URL=http://localhost:9000
# Placeholder only; replace with a local object-store access key when needed.
DRYBEAN_S3_ACCESS_KEY_ID=replace-me
# Placeholder only; replace with a local object-store secret when needed.
DRYBEAN_S3_SECRET_ACCESS_KEY=replace-me
# Placeholder only; replace with an API key when API authentication is configured.
DRYBEAN_API_KEY=replace-me
# Local development only; change these before exposing the stack to any network.
MINIO_ROOT_USER=drybean-local
MINIO_ROOT_PASSWORD=replace-this-local-password
